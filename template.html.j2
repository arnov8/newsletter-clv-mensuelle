{% macro card_bien(bien, campaign, style) %}
{% if style == 'opportunite' %}
  {% set card_bg = "linear-gradient(145deg, #0d9488, #0f766e)" %}
  {% set card_shadow = "0 8px 32px rgba(13,148,136,0.25)" %}
  {% set title_color = "#ffffff" %}
  {% set price_color = "#1a1a2e" %}
  {% set sub_color = "rgba(255,255,255,0.8)" %}
  {% set desc_color = "rgba(255,255,255,0.95)" %}
  {% set badge_bg = "rgba(255,255,255,0.2)" %}
  {% set badge_color = "#ffffff" %}
  {% set btn_disc_bg = "#ffffff" %}
  {% set btn_disc_color = "#0f766e" %}
  {% set btn_call_color = "#ffffff" %}
  {% set btn_call_border = "rgba(255,255,255,0.5)" %}
{% elif style == 'villa' %}
  {% set card_bg = "linear-gradient(145deg, #256CB8, #1a5490)" %}
  {% set card_shadow = "0 8px 32px rgba(37,108,184,0.25)" %}
  {% set title_color = "#ffffff" %}
  {% set price_color = "#fbbf24" %}
  {% set sub_color = "rgba(255,255,255,0.7)" %}
  {% set desc_color = "rgba(255,255,255,0.9)" %}
  {% set badge_bg = "rgba(255,255,255,0.2)" %}
  {% set badge_color = "#ffffff" %}
  {% set btn_disc_bg = "#ffffff" %}
  {% set btn_disc_color = "#256CB8" %}
  {% set btn_call_color = "#ffffff" %}
  {% set btn_call_border = "rgba(255,255,255,0.5)" %}
{% else %}
  {% set card_bg = "linear-gradient(145deg, #EDD49A, #C89A32)" %}
  {% set card_shadow = "0 8px 32px rgba(200,154,50,0.3)" %}
  {% set title_color = "#3D2800" %}
  {% set price_color = "#3D2800" %}
  {% set sub_color = "rgba(61,40,0,0.7)" %}
  {% set desc_color = "rgba(61,40,0,0.85)" %}
  {% set badge_bg = "rgba(61,40,0,0.12)" %}
  {% set badge_color = "#3D2800" %}
  {% set btn_disc_bg = "#3D2800" %}
  {% set btn_disc_color = "#EDD49A" %}
  {% set btn_call_color = "#3D2800" %}
  {% set btn_call_border = "rgba(61,40,0,0.4)" %}
{% endif %}
<tr><td class="sec" style="padding:0 28px 24px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" class="bento-card" style="border-radius:28px; overflow:hidden; background:{{ card_bg }}; box-shadow:{{ card_shadow }};">
        <tr><td>
            <a href="{{ get_bien_url(bien, campaign, 'photo') }}">
                <img src="{{ get_image_url(bien) }}" alt="{{ get_titre_display(bien) }} - {{ get_prix_display(bien) }}" width="584" class="card-img" style="width:100%; height:300px; object-fit:cover; display:block;">
            </a>
        </td></tr>
        <tr><td class="card-body" style="padding:20px 24px;">
            <span style="display:inline-block; padding:6px 14px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border-radius:50px; background:{{ badge_bg }}; color:{{ badge_color }}; margin-bottom:10px;">{{ get_badge(bien) }}</span>
            <h2 class="prop-title" style="font-size:24px; font-weight:700; color:{{ title_color }}; margin:0 0 6px; line-height:1.2;">
                {{ get_titre_display(bien) | truncate(48, True, '…') }} <span class="price-break" style="color:{{ price_color }};">{{ get_prix_display(bien) }}</span>
            </h2>
            <p style="font-size:13px; color:{{ sub_color }}; margin:0 0 10px; font-weight:500;">&#128205; {{ get_commune_display(bien) }}{% if get_surface_line(bien) %} &#183; {{ get_surface_line(bien) }}{% endif %}</p>
            <p style="font-size:15px; color:{{ desc_color }}; margin:0 0 16px; line-height:1.55;">{{ get_short_desc(bien) }}</p>
            <table role="presentation" cellspacing="0" cellpadding="0" width="100%" class="btn-row"><tr>
                <td style="padding-right:8px;"><a href="{{ get_bien_url(bien, campaign, 'cta') }}" class="cta-btn" style="display:inline-block; padding:14px 24px; font-size:14px; font-weight:600; border-radius:50px; background:{{ btn_disc_bg }}; color:{{ btn_disc_color }}; white-space:nowrap; text-decoration:none;">D&#233;couvrir</a></td>
                <td style="padding-right:8px;"><a href="tel:+596696334700" class="cta-btn" style="display:inline-block; padding:14px 24px; font-size:14px; font-weight:600; border-radius:50px; background:transparent; color:{{ btn_call_color }}; border:1.5px solid {{ btn_call_border }}; white-space:nowrap; text-decoration:none;">Appeler</a></td>
                <td><a href="{{ get_wa_url(bien) }}" class="cta-btn" style="display:inline-block; padding:14px 18px; font-size:14px; font-weight:600; border-radius:50px; background:#25D366; color:#ffffff; white-space:nowrap; text-decoration:none;">WhatsApp</a></td>
            </tr></table>
        </td></tr>
    </table>
</td></tr>
{% endmacro %}
