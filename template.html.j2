{% macro card_bien(card, accent) %}
{% set bien = card.bien %}
{% if accent == 'gold' %}
  {% set accent_color = "#C89A32" %}
  {% set desc_bg = "#faf5ea" %}
{% else %}
  {% set accent_color = "#0d9488" %}
  {% set desc_bg = "#f0f9f7" %}
{% endif %}
<tr><td class="sec" style="padding:0 40px 34px;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
    <tr><td style="padding-bottom:16px;">
      <a href="{{ get_bien_url(bien, campaign, 'photo') }}"><img src="{{ get_image_url(bien) }}" alt="{{ get_titre_display(bien) }}" width="560" class="ed-img" style="width:100%; height:300px; object-fit:cover; display:block; border-radius:6px;"></a>
    </td></tr>
    <tr><td>
      <p style="margin:0 0 8px; font-size:12px; letter-spacing:2px; text-transform:uppercase; color:{{ accent_color }}; font-weight:700;"><span style="color:#c7ccd4;">N°{{ '%02d'|format(card.num) }}</span>&nbsp;&nbsp;·&nbsp;&nbsp;{{ get_badge_text(bien) }}</p>
      <h3 class="prop-title" style="margin:0 0 10px; font-size:23px; font-weight:800; color:#1a1a2e; line-height:1.22; letter-spacing:-0.3px;">{{ get_titre_display(bien) }}</h3>
      <p class="prop-meta" style="margin:0 0 12px; font-size:13px; color:#8a93a3; font-weight:500;">{{ get_commune_display(bien) }}{% if get_surface_line(bien) %} · {{ get_surface_line(bien) }}{% endif %}</p>
      <p class="prop-desc" style="margin:0 0 18px; font-size:15px; color:#4a5568; line-height:1.65; background:{{ desc_bg }}; padding:14px 16px; border-radius:10px;">{{ get_short_desc(bien) }}</p>
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
        <td valign="middle" class="price-cell"><span class="prop-price" style="font-size:26px; font-weight:800; color:{{ accent_color }}; letter-spacing:-0.5px;">{{ get_prix_display(bien) }}</span></td>
        <td valign="middle" align="right" class="ed-links">
          <a href="{{ get_bien_url(bien, campaign, 'cta') }}" style="display:inline-block; font-size:14px; font-weight:700; color:{{ accent_color }}; text-decoration:none; padding:9px 18px; border:1.5px solid {{ accent_color }}; border-radius:50px;">Découvrir&nbsp;→</a>
          <a href="{{ get_wa_url(bien) }}" style="display:inline-block; margin-left:8px; font-size:14px; font-weight:700; color:#25D366; text-decoration:none; padding:9px 16px; border:1.5px solid #25D366; border-radius:50px;">WhatsApp</a>
        </td>
      </tr></table>
    </td></tr>
    <tr><td style="padding-top:30px;"><div style="height:1px; background:#e7eaef; line-height:1px; font-size:0;">&nbsp;</div></td></tr>
  </table>
</td></tr>
{% endmacro %}
{% macro card_highlight(card) %}
{% set bien = card.bien %}
<tr><td class="sec" style="padding:0 40px 34px;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#fbf7ec; border:1.5px solid #C89A32; border-radius:14px;">
    <tr><td style="padding:20px 20px 0;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:14px;"><tr>
        <td valign="middle"><span style="display:inline-block; background:#C89A32; color:#ffffff; font-size:11px; font-weight:800; letter-spacing:2px; text-transform:uppercase; padding:7px 14px; border-radius:50px;">★&nbsp;&nbsp;À ne pas manquer</span></td>
        <td valign="middle" align="right"><span style="font-size:12px; color:#a8801f; font-weight:700; letter-spacing:0.5px;">{{ get_badge_text(bien) }}</span></td>
      </tr></table>
    </td></tr>
    <tr><td style="padding:0 20px 16px;">
      <a href="{{ get_bien_url(bien, campaign, 'photo') }}"><img src="{{ get_image_url(bien) }}" alt="{{ get_titre_display(bien) }}" width="520" class="ed-img" style="width:100%; height:300px; object-fit:cover; display:block; border-radius:8px;"></a>
    </td></tr>
    <tr><td style="padding:0 20px 22px;">
      <p style="margin:0 0 8px; font-size:12px; letter-spacing:2px; text-transform:uppercase; color:#0d9488; font-weight:700;"><span style="color:#c2b48c;">N°{{ '%02d'|format(card.num) }}</span>&nbsp;&nbsp;·&nbsp;&nbsp;{{ get_badge_text(bien) }}</p>
      <h3 class="prop-title" style="margin:0 0 10px; font-size:23px; font-weight:800; color:#1a1a2e; line-height:1.22; letter-spacing:-0.3px;">{{ get_titre_display(bien) }}</h3>
      <p class="prop-meta" style="margin:0 0 12px; font-size:13px; color:#8a93a3; font-weight:500;">{{ get_commune_display(bien) }}{% if get_surface_line(bien) %} · {{ get_surface_line(bien) }}{% endif %}</p>
      <p class="prop-desc" style="margin:0 0 18px; font-size:15px; color:#4a5568; line-height:1.65; background:#ffffff; padding:14px 16px; border-radius:10px;">{{ get_short_desc(bien) }}</p>
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
        <td valign="middle" class="price-cell"><span class="prop-price" style="font-size:26px; font-weight:800; color:#0d9488; letter-spacing:-0.5px;">{{ get_prix_display(bien) }}</span></td>
        <td valign="middle" align="right" class="ed-links">
          <a href="{{ get_bien_url(bien, campaign, 'cta') }}" style="display:inline-block; font-size:14px; font-weight:700; color:#0d9488; text-decoration:none; padding:9px 18px; border:1.5px solid #0d9488; border-radius:50px;">Découvrir&nbsp;→</a>
          <a href="{{ get_wa_url(bien) }}" style="display:inline-block; margin-left:8px; font-size:14px; font-weight:700; color:#25D366; text-decoration:none; padding:9px 16px; border:1.5px solid #25D366; border-radius:50px;">WhatsApp</a>
        </td>
      </tr></table>
    </td></tr>
  </table>
</td></tr>
{% endmacro %}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="fr">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light">
<title>La sélection du Cabinet Laurent Valère — {{ mois }} {{ year }}</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style type="text/css">
  *{box-sizing:border-box;}
  body,table,td,p,a,li{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}
  table,td{mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;}
  img{-ms-interpolation-mode:bicubic;border:0;outline:none;text-decoration:none;display:block;}
  body{margin:0!important;padding:0!important;width:100%!important;}
  a{text-decoration:none;}
  a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;}
  body,td,th,p,div,h1,h2,h3,h4,h5,h6{font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
  h1,h2,h3,h4,h5,h6{margin:0;padding:0;font-weight:700;}
  p{margin:0;padding:0;}
  @media only screen and (min-width:641px){
    .container{margin:28px auto;box-shadow:0 24px 70px -24px rgba(20,30,60,0.18);}
  }
  @media only screen and (max-width:640px){
    .container{width:100%!important;max-width:100%!important;}
    .sec{padding-left:22px!important;padding-right:22px!important;}
    .logo-header{padding:0 10px!important;}
    .hero-title{font-size:36px!important;line-height:1.12!important;}
    .hero-sub{font-size:17px!important;}
    .sec-title{font-size:27px!important;}
    .ed-img{height:230px!important;}
    .prop-title{font-size:22px!important;}
    .prop-meta{font-size:14px!important;}
    .prop-desc{font-size:16px!important;line-height:1.6!important;}
    .prop-price{white-space:nowrap!important;}
    .price-cell{display:block!important;width:100%!important;padding-bottom:14px!important;}
    .ed-links{display:block!important;width:100%!important;text-align:left!important;white-space:nowrap!important;}
    .stat-row .stat-num{font-size:21px!important;}
    .stat-row .stat-label{font-size:10px!important;letter-spacing:0.5px!important;}
    .sell-pad{padding:22px 20px 26px!important;}
    .sell-photo, .sell-photo img{width:96px!important;height:96px!important;}
    .sell-photo-wrap{margin:2px 0 10px 12px!important;}
    .sell-title{font-size:22px!important;}
    .docu-pad{padding:22px 20px!important;}
    .docu-title{font-size:21px!important;line-height:1.2!important;}
    .docu-badge{display:none!important;}
  }
  @media only screen and (max-width:390px){
    .sec{padding-left:16px!important;padding-right:16px!important;}
    .hero-title{font-size:32px!important;}
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:#eef1f5; width:100%;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#eef1f5;">
<tr><td align="center" style="padding:0;">

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="width:100%; max-width:600px;">
    <tr><td align="center" style="padding:12px 20px;">
      <p style="font-size:11px; color:#a0a7b4; margin:0;">Cet e-mail ne s'affiche pas correctement ? <a href="https://www.cabinetlaurentvalere.com/newsletters/{{ mois_slug }}-{{ year }}.html" style="color:#256CB8; text-decoration:underline;">Voir en ligne</a></p>
    </td></tr>
  </table>

  <table role="presentation" class="container" width="600" cellspacing="0" cellpadding="0" style="background-color:#ffffff; max-width:600px;">

    <!-- HEADER -->
    <tr><td align="center" style="padding:8px 0 0;">
      <a href="https://www.cabinetlaurentvalere.com?utm_source=newsletter&utm_medium=email&utm_campaign={{ campaign }}&utm_content=header-logo"><img src="https://www.cabinetlaurentvalere.com/images/logo-clv-signature.png" alt="Cabinet Laurent Valère" width="520" class="logo-header" style="width:520px; max-width:100%; height:auto; display:block; margin:26px auto 8px; padding:0 40px;"></a>
    </td></tr>

    <!-- HERO éditorial -->
    <tr><td class="sec" style="padding:22px 40px 12px;">
      <div style="height:2px; background:#1a1a2e; width:100%; font-size:0; margin-bottom:22px;">&nbsp;</div>
      <p style="margin:0 0 14px; font-size:12px; letter-spacing:3px; text-transform:uppercase; color:#256CB8; font-weight:700;">La sélection · {{ mois }} {{ year }}</p>
      <h1 class="hero-title" style="margin:0 0 16px; font-size:44px; font-weight:800; color:#1a1a2e; line-height:1.06; letter-spacing:-1.2px;">À l'agence en ce moment</h1>
      <p class="hero-sub" style="margin:0 0 10px; font-size:16px; color:#4a5568; line-height:1.6; max-width:460px;">Voici les biens actuellement confiés au cabinet&nbsp;: des maisons et appartements disponibles, visitables dès maintenant, que nous connaissons dossier par dossier.</p>
      <p style="margin:0 0 22px; font-size:14px; color:#1a1a2e; font-weight:600; font-style:italic;">Arnaud Valère &amp; Laurent Valère</p>
      <table role="presentation" cellspacing="0" cellpadding="0" width="100%" class="stat-row" style="border-top:1px solid #e7eaef; padding-top:20px;">
        <tr>
          <td width="33%" valign="top" style="padding:20px 12px 0 0; border-right:1px solid #e7eaef;"><p class="stat-num" style="font-size:26px; font-weight:800; color:#1a1a2e; margin:0;">40</p><p class="stat-label" style="font-size:12px; color:#8a93a3; margin:2px 0 0; text-transform:uppercase; letter-spacing:1px;">ans d'expérience</p></td>
          <td width="34%" valign="top" style="padding:20px 12px 0; border-right:1px solid #e7eaef;"><p class="stat-num" style="font-size:26px; font-weight:800; color:#0d9488; margin:0;">{{ prix_min_display }}</p><p class="stat-label" style="font-size:12px; color:#8a93a3; margin:2px 0 0; text-transform:uppercase; letter-spacing:1px;">à partir de</p></td>
          <td width="33%" valign="top" style="padding:20px 0 0 12px;"><p class="stat-num" style="font-size:26px; font-weight:800; color:#C89A32; margin:0;">1985</p><p class="stat-label" style="font-size:12px; color:#8a93a3; margin:2px 0 0; text-transform:uppercase; letter-spacing:1px;">depuis</p></td>
        </tr>
      </table>
    </td></tr>
    <tr><td style="height:26px; font-size:0; line-height:0;">&nbsp;</td></tr>

    {% if appartement_cards %}
    <tr><td class="sec" style="padding:20px 40px 22px;">
      <div style="width:44px; height:3px; background:#0d9488; margin-bottom:16px; font-size:0;">&nbsp;</div>
      <h2 class="sec-title" style="margin:0 0 6px; font-size:30px; font-weight:800; color:#1a1a2e; letter-spacing:-0.6px;">Appartements</h2>
      <p style="margin:0; font-size:14px; color:#8a93a3;">Des appartements accessibles au fort potentiel</p>
    </td></tr>
    {% for card in appartement_cards %}
      {% if card.highlight %}{{ card_highlight(card) }}{% else %}{{ card_bien(card, 'teal') }}{% endif %}
    {% endfor %}
    {% endif %}

    <!-- CARD BLOG -->
    {% if article %}
    <tr><td class="sec" style="padding:6px 40px 40px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#eef6fc; border-radius:20px;">
        <tr><td style="padding:0;">
          <a href="{{ article.url }}"><img src="{{ article.image_url }}" alt="{{ article.titre }}" width="520" style="width:100%; height:190px; object-fit:cover; object-position:center 35%; display:block; border-radius:19px 19px 0 0;"></a>
        </td></tr>
        <tr><td class="docu-pad" style="padding:24px 30px 28px;">
          <p style="margin:0 0 10px; font-size:11px; letter-spacing:2.5px; text-transform:uppercase; color:#256CB8; font-weight:700;">Infos & conseils · {{ article.categorie }}</p>
          <h2 class="docu-title" style="margin:0 0 12px; font-size:22px; font-weight:800; color:#1a1a2e; line-height:1.25; letter-spacing:-0.5px;">{{ article.titre }}</h2>
          <p style="margin:0 0 12px; font-size:14px; color:#4a5568; line-height:1.65; background:#ffffff; border-left:3px solid #256CB8; padding:12px 16px; border-radius:0 10px 10px 0;">«&nbsp;{{ article.excerpt }}&nbsp;»</p>
          <p style="margin:0 0 20px; font-size:12px; color:#8a93a3;">{{ article.temps_lecture }} min de lecture</p>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
            <td valign="middle"><a href="{{ article.url }}" style="display:inline-block; background:#256CB8; color:#ffffff; padding:12px 24px; border-radius:50px; font-size:14px; font-weight:700;">Lire l'analyse complète&nbsp;→</a></td>
          </tr></table>
        </td></tr>
      </table>
    </td></tr>
    {% endif %}

    {% if villa_cards %}
    <tr><td class="sec" style="padding:20px 40px 22px;">
      <div style="width:44px; height:3px; background:#C89A32; margin-bottom:16px; font-size:0;">&nbsp;</div>
      <h2 class="sec-title" style="margin:0 0 6px; font-size:30px; font-weight:800; color:#1a1a2e; letter-spacing:-0.6px;">Villas &amp; investissements</h2>
      <p style="margin:0; font-size:14px; color:#8a93a3;">Des biens à fort potentiel de valorisation</p>
    </td></tr>
    {% for card in villa_cards %}
      {% if card.highlight %}{{ card_highlight(card) }}{% else %}{{ card_bien(card, 'gold') }}{% endif %}
    {% endfor %}
    {% endif %}

    <!-- ENCART DOCURBANISME -->
    <tr><td class="sec" style="padding:6px 40px 40px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f3ee; border-radius:20px;">
        <tr><td class="docu-pad" style="padding:26px 30px;">

          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:14px;"><tr>
            <td valign="middle" width="28">
              <table role="presentation" width="28" height="28" cellspacing="0" cellpadding="0"><tr>
                <td width="28" height="28" align="center" valign="middle" style="width:28px; height:28px; background:#2d8659; border-radius:50%;"><span style="display:inline-block; width:9px; height:9px; border:2px solid #ffffff; border-radius:2px; font-size:0; line-height:0;"></span></td>
              </tr></table>
            </td>
            <td valign="middle" style="padding-left:9px;"><span style="font-family:'DM Sans','Plus Jakarta Sans',-apple-system,Segoe UI,Roboto,Arial,sans-serif; font-size:17px; font-weight:700; color:#1a2421; letter-spacing:-0.4px;">docurbanisme<span style="color:#2d8659;">.</span></span></td>
            <td valign="middle" align="right" class="docu-badge"><span style="font-family:'DM Sans','Plus Jakarta Sans',Arial,sans-serif; font-size:12px; color:#2d8659; font-weight:600;">35 000+ communes · DOM inclus</span></td>
          </tr></table>

          <h2 class="docu-title" style="margin:0 0 10px; font-family:'Space Grotesk','Plus Jakarta Sans',-apple-system,Segoe UI,Roboto,Arial,sans-serif; font-size:23px; font-weight:700; color:#1a2421; line-height:1.2; letter-spacing:-0.8px;">Une parcelle ou une propriété en vue ? Sachez ce que son PLU autorise, <span style="background:#c8e0d3; padding:1px 7px; border-radius:5px; white-space:nowrap;">avant de vous engager</span>.</h2>

          <p style="margin:0 0 18px; font-family:'DM Sans','Plus Jakarta Sans',Arial,sans-serif; font-size:14px; color:#5e6964; line-height:1.6;">DocUrbanisme réunit en un seul dossier clair les documents officiels d'une parcelle : zone, règlement, cadastre, risques. Une lecture précieuse avant un achat de terrain ou un projet de construction.</p>

          <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
            <td valign="middle"><a href="https://docurbanisme.com?utm_source=newsletter-clv&utm_medium=email&utm_campaign={{ campaign }}&utm_content=encart-docurbanisme" style="display:inline-block; background:#2d8659; color:#ffffff; padding:12px 24px; border-radius:8px; font-family:'DM Sans','Plus Jakarta Sans',Arial,sans-serif; font-size:14px; font-weight:700;">Découvrir DocUrbanisme&nbsp;→</a></td>
            <td valign="middle" align="right"><span style="font-family:'DM Sans','Plus Jakarta Sans',Arial,sans-serif; font-size:12px; color:#8b958f;">dossier complet dès 14,90&nbsp;€</span></td>
          </tr></table>

        </td></tr>
      </table>
    </td></tr>

    <!-- AVIS clients éditorial -->
    <tr><td class="sec" style="padding:20px 40px 22px;">
      <div style="width:44px; height:3px; background:#1a1a2e; margin-bottom:16px; font-size:0;">&nbsp;</div>
      <p style="margin:0 0 6px; font-size:12px; letter-spacing:2.5px; text-transform:uppercase; color:#1a1a2e; font-weight:700;">Ils nous font confiance</p>
      <h2 class="sec-title" style="margin:0 0 6px; font-size:30px; font-weight:800; color:#1a1a2e; letter-spacing:-0.6px;">{{ avis.note_globale }}/5 sur Google</h2>
      <p style="margin:0; font-size:14px; color:#8a93a3;">{{ avis.nombre_avis }} avis · Note moyenne {{ avis.note_globale }} sur 5</p>
    </td></tr>

    {% for a in avis.liste %}
    <tr><td class="sec" style="padding:0 40px 16px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-top:1px solid #e7eaef;">
        <tr><td style="padding-top:18px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:10px;"><tr>
            <td width="40" valign="top"><div style="width:34px; height:34px; border-radius:50%; background:#eef1f5; text-align:center; line-height:34px; font-size:14px; font-weight:700; color:#5f6368;">{{ a.initiale }}</div></td>
            <td valign="middle" style="padding-left:10px;"><p style="font-size:14px; font-weight:700; color:#1a1a2e; margin:0;">{{ a.nom }}</p><p style="font-size:11px; color:#a0a7b4; margin:0;">{{ a.date }}</p></td>
            <td valign="middle" align="right"><span style="font-size:13px; color:#fbbc04; letter-spacing:1px;">{{ '★' * a.note }}</span></td>
          </tr></table>
          <p style="font-size:15px; color:#4a5568; margin:0; line-height:1.65;">{{ a.commentaire or '' }}</p>
        </td></tr>
      </table>
    </td></tr>
    {% endfor %}
    <tr><td class="sec" style="padding:6px 40px 30px;">
      <a href="{{ avis.lien_google }}" style="display:inline-block; font-size:14px; font-weight:700; color:#256CB8;">Voir tous nos avis Google →</a>
    </td></tr>

    <!-- CTA VENDEURS éditorial -->
    <tr><td class="sec" style="padding:0 40px 34px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f0fdfa; border:1.5px solid #0d9488; border-radius:16px;">
        <tr>
          <td class="sell-pad" style="padding:30px 34px 34px;">
            <table role="presentation" align="right" cellspacing="0" cellpadding="0" class="sell-photo-wrap" style="margin:4px 0 12px 16px;"><tr><td>
              <div class="sell-photo" style="width:116px; height:116px; border-radius:16px; overflow:hidden; box-shadow:0 8px 24px rgba(13,148,136,0.25);">
                <img src="https://www.cabinetlaurentvalere.com/images/team/arnaud-valere.jpg" alt="Arnaud Valère - Votre conseiller immobilier en Martinique" width="116" height="116" style="width:116px; height:116px; object-fit:cover; object-position:center 15%; display:block;">
              </div>
            </td></tr></table>
            <table role="presentation" cellspacing="0" cellpadding="0" style="margin:0 0 12px;"><tr>
              <td valign="middle" width="22"><img src="https://www.cabinetlaurentvalere.com/images/icons/house.png" width="16" height="16" alt="" style="width:16px; height:16px; display:block; opacity:0.8;"></td>
